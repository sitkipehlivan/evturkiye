---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { getNews, CATS, fmtDate, type Cat } from '../../../lib/util';
export async function getStaticPaths() {
  const news = await getNews();
  return news.map((post) => ({ params: { cat: post.data.category, slug: post.id }, props: { post, news } }));
}
const { post, news } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const cat = d.category as Cat;
const related = news.filter((p: any) => p.id !== post.id).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org', '@type': cat === 'rehber' ? 'Article' : 'NewsArticle',
  headline: d.title, description: d.description, datePublished: d.date.toISOString(), inLanguage: 'tr',
  publisher: { '@type': 'Organization', name: 'EV Türkiye', url: 'https://evturkiye.com.tr' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---
<Base title={d.title} description={d.description} type="article" image={d.image} jsonLd={jsonLd}>
  <article class="section-sm">
    <div class="container">
      <nav class="crumbs small muted"><a href="/haberler">Haberler</a> / <a href={`/haberler/${cat}`}>{CATS[cat].label}</a></nav>
      <header class="head">
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        <div class="meta small muted"><span class:list={['tag', cat === 'rehber' ? 'green' : 'volt']}>{CATS[cat].label}</span> <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time></div>
      </header>
      {d.image && <img class="cover" src={d.image} alt="" />}
      <div class="prose"><Content /></div>
      {d.sourceUrl && <p class="source small">Kaynak: <a href={d.sourceUrl} target="_blank" rel="noopener nofollow">{d.source ?? new URL(d.sourceUrl).hostname} ↗</a></p>}
    </div>
  </article>
  <section class="section-sm soft">
    <div class="container">
      <h2>Diğer içerikler</h2>
      <div class="grid grid-3">{related.map((p: any) => <NewsCard post={p} />)}</div>
    </div>
  </section>
</Base>
<style>
  .crumbs { margin-bottom: 14px; } .crumbs a:hover { color: var(--volt); }
  .head { max-width: 780px; margin-bottom: 28px; }
  .lede { font-size: 1.15rem; color: var(--ink-2); }
  .meta { display: flex; gap: 10px; align-items: center; }
  .cover { border-radius: var(--radius); margin-bottom: 28px; max-height: 460px; width: 100%; object-fit: cover; }
  .source { max-width: 720px; padding-top: 18px; margin-top: 28px; border-top: 1px solid var(--line); color: var(--muted); }
  .source a { color: var(--volt); }
</style>
