---
import Base from '../layouts/Base.astro';
import ops from '../data/operators.json';
import iller from '../data/iller.json';
import { ILLER, ilSlug } from '../lib/iller';
---
<Base image="/images/araclar/istasyonlar.png" title="Elektrikli Araç Şarj İstasyonları Haritası" description="Türkiye genelindeki elektrikli araç şarj istasyonlarını harita üzerinde görün; DC hızlı şarj ve operatöre göre filtreleyin." crumbs={[['Şarj istasyonları haritası', '/istasyonlar/']]} jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Elektrikli araç şarj istasyonları haritası', url: new URL(Astro.url.pathname, Astro.site).toString(), inLanguage: 'tr', isPartOf: { '@type': 'WebSite', name: 'EV Türkiye', url: Astro.site?.toString() } }}>
  <section class="section-sm">
    <div class="container">
      <span class="eyebrow">Harita</span>
      <h1>Şarj istasyonları</h1>
      <p class="muted intro"><a href="/yakindaki-sarj-istasyonlari" class="link-arrow"><b>Konumuna en yakın şarj istasyonunu bul →</b></a><br>Haritada il ve operatör seçerek Türkiye'deki elektrikli araç şarj istasyonlarını Google Haritalar üzerinde gör. Uzun yol için <a href="/rota-planlayici" class="link-arrow">Rota Planlayıcı</a></p>
      <div class="filters card">
        <select id="f-il" aria-label="İl"><option value="">Tüm Türkiye</option>{iller.map((il: string) => <option value={il}>{il}</option>)}</select>
        <select id="f-op" aria-label="Operatör"><option value="">Tüm operatörler</option>{ops.operators.map((o) => <option value={o.name}>{o.name}</option>)}</select>
        <label class="chk"><input type="checkbox" id="f-dc" /> Sadece DC hızlı şarj</label>
        <a class="btn btn-ghost" href="/yakindaki-sarj-istasyonlari">📍 Konumuma göre</a>
      </div>
      <div class="card map-wrap"><iframe id="st-map" title="Şarj istasyonları haritası" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=elektrikli%20ara%C3%A7%20%C5%9Farj%20istasyonu%20T%C3%BCrkiye&hl=tr&z=6&output=embed" allowfullscreen></iframe></div>
      <h2 class="iller-baslik">İllere göre şarj istasyonları</h2>
      <p class="iller">{ILLER.map((x, i) => <>{i > 0 && ' · '}<a href={`/sarj-istasyonlari/${ilSlug(x.ad)}/`}>{x.ad}</a></>)}</p>
      <p class="muted small">Harita Google Haritalar'dan gelir. Fiyat karşılaştırması için <a href="/sarj-fiyatlari">Şarj Fiyatları</a>; soket tipi, güç ve fiyatla en yakın istasyonlar için <a href="/yakindaki-sarj-istasyonlari">Yakınımdaki Şarj İstasyonları</a>.</p>
    </div>
  </section>
</Base>
<script>
  const il = document.getElementById('f-il') as HTMLSelectElement;
  const op = document.getElementById('f-op') as HTMLSelectElement;
  const dc = document.getElementById('f-dc') as HTMLInputElement;
  const map = document.getElementById('st-map') as HTMLIFrameElement;
  function guncelle() {
    const q = [op.value || 'elektrikli araç', dc.checked ? 'hızlı şarj istasyonu' : 'şarj istasyonu', il.value || 'Türkiye'].join(' ');
    map.src = `https://maps.google.com/maps?q=${encodeURIComponent(q)}&hl=tr&z=${il.value ? 11 : 6}&output=embed`;
  }
  [il, op, dc].forEach((el) => el.addEventListener('change', guncelle));
</script>
<style>
  .intro { max-width: 760px; }
  .iller-baslik { font-size: 1.15rem; margin: 18px 0 6px; } .iller { line-height: 2; }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; padding: 12px; margin: 16px 0 12px; }
  .filters select { width: auto; min-width: 200px; }
  .filters .btn { height: 46px; display: inline-flex; align-items: center; }
  .chk { display: flex; align-items: center; gap: 8px; margin: 0 8px; font-size: .92rem; }
  .chk input { width: 18px; height: 18px; accent-color: var(--volt); }
  .map-wrap { overflow: hidden; margin-bottom: 10px; padding: 0; }
  #st-map { display: block; width: 100%; height: 620px; border: 0; }
  @media (max-width: 640px) { #st-map { height: 460px; } }
</style>
