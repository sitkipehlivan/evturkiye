---
import Base from '../../layouts/Base.astro';
import DealCard from '../../components/DealCard.astro';
import { getDeals } from '../../lib/util';
const deals = (await getDeals()).filter((d) => d.data.type === 'arac');
---
<Base title="Elektrikli Araç Kampanyaları" description="Sıfır elektrikli araçlarda güncel faizsiz kredi ve indirim kampanyaları." crumbs={[['Fırsatlar', '/firsatlar/'], ['Araç kampanyaları', '/firsatlar/arac-kampanyalari/']]} jsonLd={{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Elektrikli araç kampanyaları', url: new URL(Astro.url.pathname, Astro.site).toString(), inLanguage: 'tr', isPartOf: { '@type': 'WebSite', name: 'EV Türkiye', url: Astro.site?.toString() } }}>
  <section class="section-sm">
    <div class="container">
      <nav class="small muted" style="margin-bottom:10px"><a href="/firsatlar">Fırsatlar</a> / Elektrikli Araç Kampanyaları</nav>
      <h1>Elektrikli Araç Kampanyaları</h1>
      <p class="muted">Sıfır elektrikli araçlarda güncel faizsiz kredi ve indirim kampanyaları.</p>
      {deals.length ? <div class="grid grid-3" style="margin-top:24px">{deals.map((d) => <DealCard deal={d} />)}</div> : <p class="muted">Şu an aktif kampanya yok.</p>}
    </div>
  </section>
</Base>
