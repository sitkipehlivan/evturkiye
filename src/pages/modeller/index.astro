---
import Base from '../../layouts/Base.astro';
import data from '../../data/models.json';
import ModelCard from '../../components/ModelCard.astro';
import { models, modelGroups, price } from '../../lib/ev';
const brands = [...new Set(models.map((m) => m.brand))].sort((a, b) => a.localeCompare(b, 'tr'));
const bodies = [...new Set(modelGroups.map((g) => g.body))];
const cards = [...modelGroups].sort((a, b) => (Number(b.onSale) - Number(a.onSale)) || (a.fromPrice ?? 9e9) - (b.fromPrice ?? 9e9));
const onSale = modelGroups.filter((g) => g.onSale);
---
<Base title="Türkiye'de Satılan Elektrikli Araçlar: Fiyat Listesi, Menzil ve Şarj" description={`Türkiye'de satılan ${modelGroups.filter((g) => g.onSale).length} elektrikli otomobil modeli: güncel liste fiyatları, WLTP menzil, batarya, DC/AC şarj gücü ve otoyol tüketimi karşılaştırması.`}>
  <section class="section-sm">
    <div class="container">
      <span class="eyebrow">EV veritabanı</span>
      <h1>Türkiye'de satılan elektrikli araçlar</h1>
      <p class="muted intro">{brands.length} markadan Türkiye'de satışta olan {onSale.length} elektrikli model ve {models.filter((m) => !m.discontinued).length} versiyon: güncel liste fiyatı, menzil ve şarj gücü. Kartlar en uygun fiyattan sıralıdır.</p>
      <div class="filters" id="cf">
        <button class="tag active" data-body="">Tüm kasalar</button>
        {bodies.map((b) => <button class="tag" data-body={b}>{b}</button>)}
      </div>
      <div class="cards" id="cards">{cards.map((g) => <ModelCard g={g} />)}</div>
      <h2 class="bh">Teknik karşılaştırma tablosu</h2>
      <p class="muted small">Marka seçerek süz, sütun başlıklarına tıklayarak sırala.</p>
      <div class="brands">
        <button class="tag active" data-b="">Tümü</button>
        {brands.map((b) => <button class="tag" data-b={b}>{b}</button>)}
      </div>
      <div class="table-wrap">
        <table id="mtable">
          <thead><tr>
            <th><button data-k="name">Model</button></th>
            <th class="num"><button data-k="price">Fiyat</button></th>
            <th class="num"><button data-k="battery">Batarya</button></th>
            <th class="num"><button data-k="wltp">WLTP menzil</button></th>
            <th class="num"><button data-k="dc">DC maks.</button></th>
            <th class="num"><button data-k="ac">AC maks.</button></th>
            <th class="num"><button data-k="hw">Otoyol tük.*</button></th>
            <th></th>
          </tr></thead>
          <tbody>
            {models.map((m) => (
              <tr data-brand={m.brand} data-name={`${m.brand} ${m.model} ${m.version}`} data-battery={m.battery} data-wltp={m.wltp} data-dc={m.dcMax} data-ac={m.acMax} data-hw={m.highway} data-price={m.priceTL ?? 0}>
                <td><a href={`/modeller/${m.brandSlug}/${m.modelSlug}`}><b>{m.brand} {m.model}</b> <span class="muted">{m.version}</span></a></td>
                <td class="num nowrap">{m.priceTL ? price(m.priceTL) : '—'}</td>
                <td class="num">{m.battery} kWh</td>
                <td class="num">{m.wltp} km</td>
                <td class="num">{m.dcMax} kW</td>
                <td class="num">{m.acMax} kW</td>
                <td class="num">{m.highway.toLocaleString('tr-TR')} kWh</td>
                <td><a class="plan" href={`/rota-planlayici?car=${m.slug}`}>Rota planla</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted small foot">* {data.note}</p>
      <h2 class="bh">Markalara göre</h2>
      <div class="brandlinks">{brands.map((b) => <a class="tag" href={`/modeller/${models.find((m) => m.brand === b)!.brandSlug}`}>{b} elektrikli araçlar</a>)}</div>
    </div>
  </section>
</Base>
<script>
  const tbody = document.querySelector('#mtable tbody')!;
  document.querySelectorAll<HTMLButtonElement>('#cf button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('#cf button').forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    document.querySelectorAll<HTMLElement>('#cards > a').forEach((c) => (c.hidden = !!b.dataset.body && c.dataset.body !== b.dataset.body));
  }));
  document.querySelectorAll<HTMLButtonElement>('.brands button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.brands button').forEach((x) => x.classList.remove('active'));
    b.classList.add('active');
    tbody.querySelectorAll<HTMLElement>('tr').forEach((r) => (r.hidden = !!b.dataset.b && r.dataset.brand !== b.dataset.b));
  }));
  let key = '', dir = 1;
  document.querySelectorAll<HTMLButtonElement>('#mtable th button').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.k!; dir = key === k ? -dir : (k === 'name' ? 1 : -1); key = k;
    const rows = [...tbody.querySelectorAll('tr')] as HTMLElement[];
    rows.sort((x, y) => (k === 'name' ? x.dataset.name!.localeCompare(y.dataset.name!, 'tr') : Number(x.dataset[k]) - Number(y.dataset[k])) * dir);
    rows.forEach((r) => tbody.appendChild(r));
  }));
</script>
<style>
  .intro { max-width: 680px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0; }
  .filters button { border: 1px solid var(--line); background: #fff; cursor: pointer; height: 32px; padding: 0 14px; font-size: .84rem; }
  .filters button.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px; }
  .cards > a[hidden] { display: none; }
  .nowrap { white-space: nowrap; }
  .brandlinks { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0; }
  .brands { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0; }
  .brands button { border: 1px solid var(--line); background: #fff; cursor: pointer; height: 32px; padding: 0 14px; font-size: .84rem; }
  .brands button.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .plan { font-size: .85rem; font-weight: 600; color: var(--volt); }
  .foot { margin-top: 12px; }
  .bh { margin-top: 32px; font-size: 1.2rem; }
</style>
