---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import c from '../../data/company.json';
import { getNews } from '../../lib/util';
const news = (await getNews()).slice(0, 12);
const owner = c.legalName || c.name;
const url = new URL(`/yazar/${c.editorSlug}`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Organization',
    name: c.byline,
    url,
    parentOrganization: { '@type': 'Organization', name: owner, url: c.website || undefined },
    employee: [{ '@type': 'Person', name: c.editor, jobTitle: c.editorTitle }],
  },
};
---
<Base title={`${c.byline}`} description={`${c.byline}: elektrikli araç haberleri, fiyat listeleri, şarj maliyetleri ve rehber içerikleri hazırlayan ekip. ${c.editorTitle}: ${c.editor}.`} jsonLd={jsonLd}>
  <section class="section-sm">
    <div class="container">
      <span class="eyebrow">Yazar</span>
      <h1>{c.byline}</h1>
      <p class="muted">{c.editorTitle}: {c.editor}</p>
      <div class="prose">
        <p>EV Türkiye'deki haber ve rehber içerikleri {c.byline} tarafından hazırlanır. Ekip; elektrikli araç haberlerini, Türkiye fiyat listelerini, şarj operatörü tarifelerini ve uzun yol planlamasına dair içerikleri resmî kaynaklardan derler, doğrular ve yayına hazırlar.</p>
        <p>İçeriklerden sitenin {c.editorTitle.toLocaleLowerCase('tr')} <b>{c.editor}</b> sorumludur. {c.editor}, EV Türkiye'nin yayın sahibi {c.name}'in kurucusudur; dijital medya ve reklam teknolojileri alanında çalışır.</p>
        <p>Yayın ilkelerimiz ve düzeltme politikamız için <a href="/yayin-ilkeleri">Yayın İlkeleri</a>, yayın sahibi ve iletişim bilgileri için <a href="/kunye">Künye</a> sayfasına bakabilirsiniz.</p>
      </div>
      <h2 class="sub">Son içerikler</h2>
      <div class="grid grid-3">{news.map((p) => <NewsCard post={p} />)}</div>
    </div>
  </section>
</Base>
<style>.sub { margin: 32px 0 16px; }</style>
