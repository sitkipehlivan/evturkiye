---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import GuideLinks from '../components/GuideLinks.astro';
import ops from '../data/operators.json';
const gmKey = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '';
const gmMapId = import.meta.env.PUBLIC_GOOGLE_MAP_ID || '';
const payload = JSON.stringify({ gmKey, gmMapId, operators: ops.operators.map((o) => ({ id: o.id, name: o.name, dc: o.dc, ac: o.ac, match: o.match })) });
const faq = [
  { q: 'En yakın elektrikli araç şarj istasyonunu nasıl bulurum?', a: 'Bu sayfada "Konumumu kullan" düğmesine basın. Çevrenizdeki şarj istasyonları yakından uzağa sıralanır; her istasyon için güç, soket tipi ve tahmini kWh fiyatı görünür. Tek dokunuşla Google Haritalar veya Apple Haritalar üzerinden yol tarifi alabilirsiniz.' },
  { q: 'Konum bilgim saklanıyor mu?', a: 'Hayır. Konumunuz yalnızca çevrenizdeki istasyonları aramak için kullanılır ve kaydedilmez.' },
  { q: 'İstasyonun boş olup olmadığını görebilir miyim?', a: 'Operatör bu bilgiyi paylaşıyorsa, istasyon kartında müsait soket sayısı gösterilir. Bilgi her istasyon için mevcut değildir; yola çıkmadan önce operatör uygulamasından teyit etmenizi öneririz.' },
  { q: 'Hangi soket tipi aracıma uyar?', a: 'Türkiye\'de satılan elektrikli otomobillerin neredeyse tamamı AC şarjda Type 2, DC hızlı şarjda CCS2 soket kullanır. Bazı eski Nissan Leaf ve Mitsubishi modelleri DC\'de CHAdeMO kullanır; Renault Twingo E-Tech ve smart fortwo gibi bazı küçük modellerde ise DC girişi yoktur.' },
  { q: 'Hızlı şarj (DC) ile normal şarj (AC) arasındaki fark nedir?', a: 'AC istasyonlar genelde 7–22 kW verir ve aracı birkaç saatte doldurur; alışveriş, iş ya da otelde uzun beklemeler için uygundur. DC istasyonlar 50–400 kW verir; çoğu araç %10\'dan %80\'e 20–45 dakikada gelir. DC\'nin kWh fiyatı AC\'ye göre genelde daha yüksektir.' },
  { q: 'Şarj ücreti nasıl hesaplanır?', a: 'Operatörler çoğunlukla aktarılan enerji (kWh) üzerinden ücret alır. Örneğin 50 kWh\'lik bir şarj, kWh fiyatı 12 TL olan bir istasyonda yaklaşık 600 TL tutar. Bazı operatörler park süresi aşımı için ek ücret uygulayabilir; ayrıntıyı operatörün uygulamasından kontrol edin.' },
];
const dcSirali = [...ops.operators].sort((a, b) => a.dc - b.dc);
const ortDc = ops.operators.reduce((s, o) => s + o.dc, 0) / ops.operators.length;
const tlf = (v: number) => v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';
const guncel = new Date(ops.updated).toLocaleDateString('tr-TR', { month: 'long', year: 'numeric' });
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebApplication', name: 'EV Türkiye Yakınımdaki Şarj İstasyonları', applicationCategory: 'TravelApplication', operatingSystem: 'Web', inLanguage: 'tr-TR', isAccessibleForFree: true, offers: { '@type': 'Offer', price: 0, priceCurrency: 'TRY' }, description: 'Konuma göre en yakın elektrikli araç şarj istasyonlarını güç, soket tipi, müsaitlik ve tahmini kWh fiyatıyla listeler; Google veya Apple Haritalar ile yol tarifi verir.' },
  { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
] };
---
<Base image="/images/araclar/yakindaki-sarj.png" title="Yakınımdaki Elektrikli Araç Şarj İstasyonları (Harita)" description="Konumunuza en yakın elektrikli araç şarj istasyonlarını bulun: DC hızlı şarj, soket tipi, güç, kWh fiyatı ve tek dokunuşla Google Haritalar / Apple Haritalar yol tarifi." jsonLd={jsonLd}>
  <section class="section-sm">
    <div class="container" data-near>
      <script type="application/json" set:html={payload} />
      <span class="eyebrow">Şarj bul</span>
      <h1>Yakınımdaki şarj istasyonları</h1>
      <p class="lede">Konumunu paylaş, çevrendeki şarj istasyonlarını yakından uzağa sıralayalım. İstediğine dokun, Google Haritalar ya da Apple Haritalar ile yola çık.</p>

      <div class="nr-bar card">
        <button class="btn btn-volt nr-me" data-me>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="8"/></svg>
          Konumumu kullan
        </button>
        <div class="nr-or">veya</div>
        <div class="nr-addr"><input data-addr placeholder="Adres veya yer yaz (ör. Kızılay, Ankara)" autocomplete="off" /><ul class="nr-suggest" hidden></ul></div>
        <label class="nr-dc"><input type="checkbox" data-dc checked /> Yalnızca hızlı şarj (DC)</label>
      </div>
      <p class="nr-status" data-status hidden role="status"></p>
      <aside class="nr-demo" data-demo-slot hidden></aside>

      <div class="nr-grid" data-grid hidden>
        <div class="card nr-map-wrap"><div class="nr-map" data-map></div></div>
        <ol class="nr-list" data-list></ol>
      </div>
      <p class="muted small">İstasyon bilgileri Google Haritalar'dan alınır; fiyatlar operatörlerin standart tarifelerine göre tahminidir. Konumunuz kaydedilmez.</p>

      <div class="nr-info">
        <h2>Nasıl çalışır?</h2>
        <ol class="nr-steps">
          <li><b>Konumunu ver ya da bir adres yaz.</b> Konum yalnızca o anki arama için kullanılır, kaydedilmez.</li>
          <li><b>İstasyonlar yakından uzağa sıralanır.</b> Her istasyonda mesafe, operatör, en yüksek şarj gücü (kW), soket tipleri ve operatör paylaşıyorsa o an müsait soket sayısı görünür.</li>
          <li><b>Tahmini fiyatı gör.</b> İstasyonun operatörünü tanırsak, aşağıdaki fiyat tablosundaki standart kWh tarifesini kartta gösteririz.</li>
          <li><b>Yola çık.</b> Tek dokunuşla Google Haritalar ya da Apple Haritalar'da yol tarifini başlat.</li>
        </ol>

        <h2>Operatörlere göre hızlı şarj fiyatı ({guncel})</h2>
        <p>Türkiye'deki {ops.operators.length} operatörün standart DC hızlı şarj fiyatlarının ortalaması <b>{tlf(ortDc)}/kWh</b>. En ucuz ile en pahalı arasında kWh başına {tlf(dcSirali.at(-1)!.dc - dcSirali[0].dc)} fark var; 60 kWh'lik bir şarjda bu yaklaşık {Math.round((dcSirali.at(-1)!.dc - dcSirali[0].dc) * 60).toLocaleString('tr-TR')} TL demek. Yakındaki iki istasyondan birini seçerken operatöre bakmak bu yüzden önemli.</p>
        <div class="table-wrap"><table>
          <thead><tr><th>Operatör</th><th>DC (hızlı)</th><th>AC (normal)</th><th>60 kWh DC şarj</th></tr></thead>
          <tbody>{dcSirali.map((o) => <tr><td><a href={`/sarj-fiyatlari/${o.id}/`}>{o.name}</a></td><td>{tlf(o.dc)}</td><td>{o.ac ? tlf(o.ac) : '—'}</td><td>{Math.round(o.dc * 60).toLocaleString('tr-TR')} TL</td></tr>)}</tbody>
        </table></div>
        <p class="muted small">Kampanyasız standart tarifeler; üyelik, abonelik ve dönemsel indirimler hariç. Tüm ayrıntılar: <a href="/sarj-fiyatlari/">Şarj fiyatları karşılaştırması</a>.</p>

        <h2>Soket tipleri</h2>
        <div class="table-wrap"><table>
          <thead><tr><th>Soket</th><th>Akım</th><th>Tipik güç</th><th>Kullanan araçlar</th></tr></thead>
          <tbody>
            <tr><td>Type 2</td><td>AC</td><td>7–22 kW</td><td>Türkiye'deki hemen tüm elektrikliler (normal şarj)</td></tr>
            <tr><td>CCS2 (Combo 2)</td><td>DC</td><td>50–400 kW</td><td>Togg, Tesla, Hyundai, Kia, BYD, Volkswagen ve çoğu güncel model (hızlı şarj)</td></tr>
            <tr><td>CHAdeMO</td><td>DC</td><td>50 kW civarı</td><td>Eski Nissan Leaf, Mitsubishi gibi bazı Japon modelleri</td></tr>
          </tbody>
        </table></div>

        <h2>İstasyonda dikkat edilecekler</h2>
        <ul>
          <li><b>Müsaitliği teyit et:</b> Müsait soket bilgisi her istasyonda yok. Uzun yolda yola çıkmadan önce operatörün uygulamasından kontrol et.</li>
          <li><b>Aracının gücüne uygun istasyonu seç:</b> 50 kW'a kadar şarj olan bir araç için 300 kW'lık istasyona gitmek süreyi kısaltmaz; daha ucuz bir istasyon aynı işi görür.</li>
          <li><b>%80'de bırak:</b> Çoğu araçta %80'den sonra şarj hızı belirgin düşer. Uzun yolda %10–%80 arası şarj en hızlısıdır.</li>
          <li><b>Park süresine dikkat:</b> Bazı operatörler şarj bittikten sonra bekleyen araçlardan ek ücret alabilir.</li>
        </ul>
        <p>Uzun yol için durakları önceden görmek istersen <a href="/rota-planlayici/">Rota Planlayıcı</a> aracını seç ve yolu planla; hangi istasyonda ne kadar şarj edeceğini ve toplam maliyeti hesaplar.</p>
      </div>

      <Faq items={faq} />
      <GuideLinks />
    </div>
  </section>
  <script is:inline>
    // Marka sunumları için reklam demosu: ?demo=turkcell ile açılınca 300x600 kreatif sağda (mobilde arama çubuğunun altında) görünür.
    // Parametre yoksa hiçbir şey olmaz; demo sayfasında sitenin kendi reklamları da yüklenmez (Base.astro).
    (function () {
      var DEMOS = { turkcell: '/reklam-demo/turkcell/creatives/interactive-skyscraper/' };
      var key = new URLSearchParams(location.search).get('demo'), src = key && DEMOS[key]; if (!src) return;
      var box = document.querySelector('[data-demo-slot]'); if (!box) return;
      box.innerHTML = '<div class="nr-demo-in"><div class="nr-demo-label">Reklam</div><iframe src="' + src + '" width="300" height="600" scrolling="no" title="Reklam"></iframe></div>';
      box.hidden = false; box.parentElement.classList.add('has-demo');
    })();
  </script>
</Base>
<style>
  .nr-info { max-width: 860px; margin: 36px 0 8px; }
  .nr-info h2 { margin: 32px 0 12px; }
  .nr-steps { padding-left: 1.2em; display: grid; gap: 8px; }
  .table-wrap { overflow-x: auto; }
  .nr-info td, .nr-info th { white-space: normal; }
</style>

<script>
  import { loadGoogle, GoogleAutocomplete, GoogleMapView, type Pin } from '../scripts/google';
  import { findOperator, haversine, type Operator } from '../scripts/planner-core';
  import { authEnabled, onUser, currentUser, idToken } from '../scripts/auth';
  import { openAuth } from '../scripts/auth-ui';
  import { NEAR_LIMITS } from '../lib/firebase-config';

  // Misafir için cihaz bazlı günlük hak (aynı ~1 km'lik bölge tekrar sayılmaz)
  const QKEY = 'evt-yakin-hakki';
  const today = () => new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Istanbul' });
  const qRead = (): string[] => { try { const v = JSON.parse(localStorage.getItem(QKEY) || 'null'); return v?.day === today() ? v.keys : []; } catch { return []; } };
  const qAdd = (k: string) => { const keys = qRead(); if (!keys.includes(k)) keys.push(k); try { localStorage.setItem(QKEY, JSON.stringify({ day: today(), keys })); } catch {} };
  const userReady = new Promise<void>((res) => { onUser(() => res()); });

  const root = document.querySelector<HTMLElement>('[data-near]')!;
  const data = JSON.parse(root.querySelector('script[type="application/json"]')!.textContent || '{}');
  const operators: Operator[] = data.operators;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector(s) as T;
  const status = $('[data-status]'), list = $('[data-list]'), dcOnly = $<HTMLInputElement>('[data-dc]');
  const mapEl = $('[data-map]');
  let view: GoogleMapView | null = null;
  let last: { at: [number, number]; stations: any[] } | null = null;

  const say = (t: string, err = false) => { status.textContent = t; status.hidden = !t; status.classList.toggle('error', err); };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const tl = (v: number) => v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
  const km = (d: number) => (d < 1 ? `${Math.round(d * 1000)} m` : `${d.toLocaleString('tr-TR', { maximumFractionDigits: 1 })} km`);
  const isIOS = /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && 'ontouchend' in document;

  // Google haritası yalnızca üye arama yaptığında yüklenir (misafir ziyaretleri kota harcamaz)
  let member = false;
  onUser((u) => { member = !!u; });
  let mapPromise: Promise<void> | null = null;
  const ensureMap = () => (mapPromise ??= (data.gmKey ? loadGoogle(data.gmKey) : Promise.reject(new Error('x')))
    .then(async () => { mapEl.innerHTML = ''; view = await GoogleMapView.create(mapEl, data.gmMapId || 'DEMO_MAP_ID'); })
    .catch(() => { mapPromise = null; say('Harita şu an yüklenemedi.', true); }));

  // Konum
  $('[data-me]').addEventListener('click', () => {
    if (!navigator.geolocation) { say('Tarayıcınız konum paylaşımını desteklemiyor. Adres yazarak arayabilirsiniz.', true); return; }
    say('Konumunuz alınıyor…');
    navigator.geolocation.getCurrentPosition(
      (p) => search([p.coords.latitude, p.coords.longitude]),
      (e) => say(e.code === 1 ? 'Konum izni verilmedi. Tarayıcı ayarlarından izin verebilir ya da adres yazarak arayabilirsiniz.' : 'Konum alınamadı. Adres yazarak arayabilirsiniz.', true),
      { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 },
    );
  });

  if (new URLSearchParams(location.search).get('konum') === '1') ($('[data-me]') as HTMLButtonElement).click();

  // Adresle arama (Google otomatik tamamlama)
  const ac = new GoogleAutocomplete();
  const addr = $<HTMLInputElement>('[data-addr]'), sug = $<HTMLUListElement>('.nr-suggest');
  let t: number | undefined;
  addr.addEventListener('input', () => {
    clearTimeout(t);
    const q = addr.value.trim();
    if (q.length < 3) { sug.hidden = true; return; }
    t = window.setTimeout(async () => {
      try {
        const res = member && data.gmKey && (await loadGoogle(data.gmKey).then(() => true, () => false))
          ? await ac.suggest(q)
          : await photon(q);
        if (addr.value.trim() !== q) return;
        sug.innerHTML = '';
        res.forEach((r) => {
          const li = document.createElement('li');
          li.textContent = r.label;
          li.addEventListener('mousedown', async (e) => {
            e.preventDefault(); addr.value = r.label; sug.hidden = true;
            const p = await r.resolve(); search([p.lat, p.lon]);
          });
          sug.appendChild(li);
        });
        sug.hidden = !res.length;
      } catch { /* yoksay */ }
    }, 280);
  });
  addr.addEventListener('blur', () => setTimeout(() => (sug.hidden = true), 150));
  dcOnly.addEventListener('change', () => last && render(last.at, last.stations));

  async function photon(q: string): Promise<{ label: string; resolve: () => Promise<{ lat: number; lon: number }> }[]> {
    const r = await fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(q)}&limit=6&bbox=25.6,35.8,44.9,42.2`);
    const j = await r.json();
    return (j.features || []).map((f: any) => {
      const p = f.properties;
      const label = [p.name, p.district, p.city || p.county, p.state].filter(Boolean).filter((v: string, i: number, a: string[]) => a.indexOf(v) === i).slice(0, 3).join(', ');
      return { label, resolve: async () => ({ lat: f.geometry.coordinates[1], lon: f.geometry.coordinates[0] }) };
    });
  }

  async function search(at: [number, number], retried = false) {
    say('Yakındaki şarj istasyonları aranıyor…');
    try {
      const spot = `${at[0].toFixed(2)},${at[1].toFixed(2)}`;
      const members = authEnabled();
      if (members) await userReady;
      if (members && !currentUser() && !qRead().includes(spot) && qRead().length >= NEAR_LIMITS.guest) {
        say('');
        const u = await openAuth({ reason: `Üye olmadan günde ${NEAR_LIMITS.guest} arama yapabilirsiniz. Ücretsiz üye olun, günde ${NEAR_LIMITS.member} aramaya kadar devam edin.` });
        if (!u) { say(`Bugünkü ${NEAR_LIMITS.guest} ücretsiz arama hakkınızı kullandınız. Devam etmek için ücretsiz üye olun veya giriş yapın.`, true); return; }
        member = true;
        say('Yakındaki şarj istasyonları aranıyor…');
      }
      ($('[data-grid]') as HTMLElement).hidden = false;
      const mapReady = ensureMap();
      const q = `${at[0].toFixed(3)},${at[1].toFixed(3)}`;
      const token = members ? await idToken().catch(() => null) : null;
      const res = await fetch(`/api/yakin?at=${q}`, token ? { headers: { Authorization: `Bearer ${token}` } } : undefined);
      const j = await res.json().catch(() => ({}));
      if ((res.status === 429 || res.status === 401) && j.needLogin && members && !retried) {
        const u = await openAuth({ reason: j.error });
        if (u) return search(at, true);
      }
      if (!res.ok) throw new Error(j.error || 'İstasyonlar alınamadı.');
      qAdd(spot);
      last = { at, stations: j.stations || [] };
      await mapReady;
      render(at, last.stations);
    } catch (e: any) { say(e.message, true); }
  }

  function render(at: [number, number], all: any[]) {
    const rows = all
      .map((s) => {
        const dcConns = s.connectors.filter((c: any) => c.dc);
        const maxKw = Math.max(0, ...s.connectors.map((c: any) => c.kw || 0));
        const op = findOperator(s.name, operators);
        return { ...s, d: haversine(at, [s.lat, s.lon]), dc: dcConns.length > 0, maxKw, op };
      })
      .filter((s) => !dcOnly.checked || s.dc)
      .sort((a, b) => a.d - b.d);
    say(rows.length ? '' : dcOnly.checked ? 'Yakınınızda hızlı şarj (DC) istasyonu bulunamadı. Filtreyi kaldırıp AC istasyonlara da bakabilirsiniz.' : 'Yakınınızda şarj istasyonu bulunamadı.');

    list.innerHTML = rows.map((s, i) => {
      const conns = s.connectors.map((c: any) => `<span class="cn ${c.dc ? 'dc' : 'ac'}">${esc(c.type)}${c.kw ? ` · ${Math.round(c.kw)} kW` : ''}${c.count ? ` · ${c.available != null ? `<b>${c.available}/${c.count} müsait</b>` : `${c.count} adet`}` : ''}</span>`).join('');
      const price = s.op ? `${tl(s.dc ? s.op.dc : (s.op.ac ?? s.op.dc))}/kWh` : '';
      const g = `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lon}&destination_place_id=${encodeURIComponent(s.id)}&travelmode=driving`;
      const a = `https://maps.apple.com/?daddr=${s.lat},${s.lon}&dirflg=d&q=${encodeURIComponent(s.name)}`;
      return `<li class="nr-card card" data-i="${i}">
        <div class="nr-top"><span class="nr-num">${i + 1}</span><div class="nr-name"><h3>${esc(s.name)}</h3><p>${esc(s.address)}</p></div><span class="nr-dist">${km(s.d)}</span></div>
        <div class="nr-conns">${conns || '<span class="cn">Soket bilgisi yok</span>'}</div>
        <div class="nr-meta">${s.op ? `<span>${esc(s.op.name)} · <b>${price}</b></span>` : ''}${s.openNow === false ? '<span class="warn">Şu an kapalı</span>' : ''}</div>
        <div class="nr-go">
          <a class="btn btn-volt" target="_blank" rel="noopener" href="${isIOS ? a : g}">${isIOS ? 'Apple Haritalar' : 'Google Haritalar'} ile git</a>
          <a class="btn btn-ghost" target="_blank" rel="noopener" href="${isIOS ? g : a}">${isIOS ? 'Google Haritalar' : 'Apple Haritalar'}</a>
        </div>
      </li>`;
    }).join('');

    if (view) {
      const pins: Pin[] = [
        { lat: at[0], lon: at[1], kind: 'me', html: 'Konumunuz' },
        ...rows.slice(0, 20).map((s, i) => ({ lat: s.lat, lon: s.lon, kind: 'near' as const, label: String(i + 1), html: `<b>${esc(s.name)}</b><br>${km(s.d)}${s.maxKw ? ` · ${Math.round(s.maxKw)} kW` : ''}` })),
      ];
      view.pins(pins, (i) => { if (i > 0) list.querySelector(`[data-i="${i - 1}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
    }
  }
</script>

<style is:global>
  .lede { font-size: 1.08rem; color: var(--ink-2); max-width: 760px; }
  .nr-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 16px; margin: 18px 0 10px; }
  .nr-me { display: inline-flex; gap: 8px; align-items: center; height: 46px; }
  .nr-or { color: var(--muted); font-size: .85rem; }
  .nr-addr { position: relative; flex: 1 1 260px; }
  .nr-addr input { width: 100%; height: 46px; border: 1px solid var(--line); border-radius: 12px; padding: 0 14px; font: inherit; }
  .nr-suggest { position: absolute; z-index: 50; top: calc(100% + 4px); left: 0; right: 0; list-style: none; margin: 0; padding: 6px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); }
  .nr-suggest li { padding: 9px 10px; border-radius: 8px; cursor: pointer; font-size: .9rem; }
  .nr-suggest li:hover { background: var(--volt-soft); }
