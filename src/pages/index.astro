---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import RouteWidget from '../components/RouteWidget.astro';
import AdSlot from '../components/AdSlot.astro';
import DealCard from '../components/DealCard.astro';
import ops from '../data/operators.json';
import routes from '../data/routes.json';
import { getNews, getDeals, fmtDate, tl, CATS, newsImg, hasRealImg, type Cat } from '../lib/util';

const news = await getNews();
const deals = (await getDeals()).slice(0, 3);
// Manşet: görseli olan en yeni haberler önce, sonra diğerleri (en fazla 6)
const withImg = news.filter((p) => hasRealImg(p));
const heroPosts = [...withImg, ...news.filter((p) => !hasRealImg(p))].slice(0, 6);
const heroIds = new Set(heroPosts.map((p) => p.id));
const latest = news.filter((p) => !heroIds.has(p.id)).slice(0, 4);
const used = new Set([...heroIds, ...latest.map((p) => p.id)]);
const byCat = (c: Cat, n: number) => news.filter((p) => p.data.category === c && !used.has(p.id)).slice(0, n);
const turkiye = news.filter((p) => !['rehber', 'hibrit'].includes(p.data.category) && !used.has(p.id)).slice(0, 4);
const rehber = byCat('rehber', 4);
const hibrit = news.filter((p) => p.data.category === 'hibrit' && !used.has(p.id)).slice(0, 4);
const card = (p: any) => ({ p, cat: p.data.category as Cat, img: newsImg(p), url: `/haberler/${p.data.category}/${p.id}` });
const cheapest = [...ops.operators].sort((a, b) => a.dc - b.dc).slice(0, 5);
const majors = ['trugo', 'zes', 'esarj', 'tesla', 'voltrun', 'astor'].map((id) => ops.operators.find((o) => o.id === id)!).filter(Boolean);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'EV Türkiye', alternateName: 'Electric Vehicle Türkiye', url: Astro.site!.origin,
  potentialAction: { '@type': 'SearchAction', target: `${Astro.site!.origin}/ara?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
};
---
<Base title="EV Türkiye: Elektrikli Araç Haberleri, Şarj Fiyatları ve Rota Planlayıcı" jsonLd={jsonLd}>
  <!-- 1. Manşet + rota widget -->
  <section class="top">
    <div class="container top-grid">
      <HeroSlider posts={heroPosts} />
      <aside class="side" aria-label="Rota planlayıcı ve şarj fiyatları">
        <RouteWidget />
        <div class="mpu">
          <AdSlot id="home-mpu-1" size="300x250" />
          <div class="fallback prices-mini">
            <div class="pm-head"><span>En uygun DC şarj</span><a href="/sarj-fiyatlari">Tümü</a></div>
            <ol>
              {cheapest.map((o) => <li><span>{o.name}</span><b>{tl(o.dc)}</b></li>)}
            </ol>
            <p>₺/kWh · {fmtDate(new Date(ops.updated))}</p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 2. En yeniler -->
  <section class="block">
    <div class="container">
      <div class="block-head"><h2>En yeniler</h2><a href="/haberler">Tüm haberler</a></div>
      <div class="cards-4">
        {latest.map(card).map((c) => (
          <a class="nc" href={c.url}>
            <div class:list={['nc-img', c.cat]}>{c.img ? <img src={c.img} alt="" loading="lazy" /> : <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M66 6 46 33h14l-6 21 22-30H62l4-18Z" fill="currentColor" /></svg>}</div>
            <span class:list={['nc-cat', c.cat]}>{CATS[c.cat].label}</span>
            <h3>{c.p.data.title}</h3>
            <time datetime={c.p.data.date.toISOString()}>{fmtDate(c.p.data.date)}</time>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container ad-row"><AdSlot id="home-leaderboard-1" size="970x250" mobile="300x250" /></div>

  <!-- 3. Türkiye + kenar çubuğu -->
  <section class="block">
    <div class="container with-side">
      <div class="main-col">
        {turkiye.length > 0 && (
          <>
            <div class="block-head"><h2>Gündem</h2><a href="/haberler">Tümü</a></div>
            <div class="feature">
              {turkiye.slice(0, 1).map(card).map((c) => (
                <a class="fe-lead" href={c.url}>
                  <div class:list={['nc-img', c.cat]}>{c.img ? <img src={c.img} alt="" loading="lazy" /> : <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M66 6 46 33h14l-6 21 22-30H62l4-18Z" fill="currentColor" /></svg>}</div>
                  <h3>{c.p.data.title}</h3>
                  <p>{c.p.data.description}</p>
                </a>
              ))}
              <ul class="fe-list">
                {turkiye.slice(1).map(card).map((c) => (
                  <li><a href={c.url}><span class:list={['nc-cat', c.cat]}>{CATS[c.cat].label} · {fmtDate(c.p.data.date)}</span><h4>{c.p.data.title}</h4></a></li>
                ))}
              </ul>
            </div>
          </>
        )}

        {hibrit.length > 0 && (
          <>
            <div class="block-head"><h2>Plug-in Hibrit</h2><a href="/haberler/hibrit">Tümü</a></div>
            <div class="cards-2">
              {hibrit.map(card).map((c) => (
                <a class="nc row" href={c.url}>
                  <div class:list={['nc-img', c.cat]}>{c.img ? <img src={c.img} alt="" loading="lazy" /> : <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M66 6 46 33h14l-6 21 22-30H62l4-18Z" fill="currentColor" /></svg>}</div>
                  <div><span class="nc-cat hibrit">Plug-in Hibrit</span><h3>{c.p.data.title}</h3></div>
                </a>
              ))}
            </div>
          </>
        )}

        <div class="block-head"><h2>Rehber</h2><a href="/haberler/rehber">Tüm rehberler</a></div>
        <div class="cards-2">
          {rehber.map(card).map((c) => (
            <a class="nc row" href={c.url}>
              <div class:list={['nc-img', c.cat]}>{c.img ? <img src={c.img} alt="" loading="lazy" /> : <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M66 6 46 33h14l-6 21 22-30H62l4-18Z" fill="currentColor" /></svg>}</div>
              <div><span class="nc-cat rehber">Rehber</span><h3>{c.p.data.title}</h3></div>
            </a>
          ))}
        </div>
      </div>
      <aside class="side-col">
        <div class="sticky">
          <AdSlot id="home-halfpage" size="300x600" />
          <div class="fallback side-box">
            <h3>Popüler rotalar</h3>
            <ul>
              {routes.slice(0, 8).map((r) => <li><a href={`/rota/${r.slug}`}>{r.from} <span aria-hidden="true">→</span> {r.to}</a></li>)}
            </ul>
            <a class="side-cta" href="/rota-planlayici">Kendi rotanı planla</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- 4. Şarj fiyatları şeridi -->
  <section class="block soft">
    <div class="container">
      <div class="block-head"><h2>Şarj fiyatları</h2><a href="/sarj-fiyatlari">Tüm operatörler</a></div>
      <div class="prices">
        {majors.map((o) => (
          <div class="price">
            <span>{o.name}</span>
            <b>{tl(o.dc)}</b>
            <em>DC /kWh · AC {tl(o.ac)}</em>
          </div>
        ))}
      </div>
      <p class="upd">Son güncelleme: {fmtDate(new Date(ops.updated))}. Şarj öncesi operatör uygulamasından teyit edin.</p>
    </div>
  </section>

  <!-- 5. Fırsatlar -->
  {deals.length > 0 && (
    <section class="block">
      <div class="container">
        <div class="block-head"><h2>Fırsatlar</h2><a href="/firsatlar">Tüm kampanyalar</a></div>
        <div class="grid grid-3">{deals.map((d) => <DealCard deal={d} />)}</div>
      </div>
    </section>
  )}

  <div class="container ad-row last"><AdSlot id="home-leaderboard-2" size="728x90" mobile="320x100" /></div>
</Base>

<style>
  .top { padding: 28px 0 8px; }
  .top-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; align-items: start; }
  .side { display: flex; flex-direction: column; gap: 20px; }
  .mpu { width: 300px; height: 250px; }
  :global(html.ads-on) .fallback { display: none; }

  .prices-mini { height: 250px; box-sizing: border-box; border: 1px solid var(--line); padding: 14px 16px; display: flex; flex-direction: column; }
  .pm-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  .pm-head span { font: 800 .95rem var(--font-head); }
  .pm-head a { font-size: .78rem; font-weight: 600; color: var(--volt); }
  .prices-mini ol { list-style: none; margin: 0; padding: 0; flex: 1; }
  .prices-mini li { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: .86rem; }
  .prices-mini li:first-child b { color: var(--green); }
  .prices-mini b { font-variant-numeric: tabular-nums; }
  .prices-mini p { margin: 8px 0 0; font-size: .72rem; color: var(--muted); }

  .block { padding: 44px 0; }
  .block.soft { background: var(--soft); }
  .block-head { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; }
  .block-head h2 { margin: 0; font-size: .95rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .block-head::after { content: ''; order: 2; flex: 1; height: 1px; background: var(--line); }
  .block-head a { order: 3; font-size: .82rem; font-weight: 600; color: var(--ink-2); }
  .block-head a:hover { color: var(--volt); }

  .nc { display: flex; flex-direction: column; gap: 8px; color: var(--ink); }
  .nc:hover h3, .fe-lead:hover h3, .fe-list a:hover h4 { color: var(--volt); }
  .nc-img { aspect-ratio: 16 / 10; overflow: hidden; display: grid; place-items: center; background: var(--soft-2); }
  .nc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
  .nc:hover .nc-img img, .fe-lead:hover .nc-img img { transform: scale(1.04); }
  .nc-img svg { width: 30%; }
  .nc-img.turkiye { background: #eaf3ff; color: var(--volt); }
  .nc-img.dunya { background: #eef1ff; color: #3b5bfd; }
  .nc-img.hibrit { background: #e6f6f7; color: #0e8c99; }
  .nc-img.rehber { background: var(--green-soft); color: var(--green); }
  .nc-cat { font: 700 .7rem var(--font-head); letter-spacing: .14em; text-transform: uppercase; color: var(--green); margin-top: 4px; }
  .nc-cat.turkiye { color: var(--volt); } .nc-cat.dunya { color: #3b5bfd; } .nc-cat.hibrit { color: #0e8c99; }
  .nc h3 { margin: 0; font-size: 1.05rem; line-height: 1.35; transition: color .15s; }
  .nc time { font-size: .78rem; color: var(--muted); }
  .cards-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }

  .ad-row { padding: 8px 20px; }
  .ad-row.last { padding-bottom: 40px; }

  .with-side { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 40px; }
  .main-col > .block-head:not(:first-child) { margin-top: 44px; }
  .feature { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; }
  .fe-lead { display: flex; flex-direction: column; gap: 10px; color: var(--ink); }
  .fe-lead h3 { margin: 6px 0 0; font-size: 1.45rem; line-height: 1.25; transition: color .15s; }
  .fe-lead p { margin: 0; color: var(--ink-2); font-size: .95rem; }
  .fe-list { list-style: none; margin: 0; padding: 0; }
  .fe-list li { border-bottom: 1px solid var(--line); }
  .fe-list li:first-child { border-top: 1px solid var(--line); }
  .fe-list a { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; color: var(--ink); }
  .fe-list h4 { margin: 0; font-size: 1rem; line-height: 1.35; transition: color .15s; }
  .cards-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 28px; }
  .nc.row { flex-direction: row; gap: 14px; align-items: flex-start; }
  .nc.row .nc-img { width: 132px; flex: none; aspect-ratio: 4 / 3; }
  .nc.row h3 { font-size: .98rem; margin-top: 4px; }

  .sticky { position: sticky; top: 20px; display: flex; flex-direction: column; gap: 20px; }
  .side-box { border: 1px solid var(--line); padding: 18px 20px; }
  .side-box h3 { margin: 0 0 8px; font-size: .9rem; letter-spacing: .12em; text-transform: uppercase; }
  .side-box ul { list-style: none; margin: 0; padding: 0; }
  .side-box li a { display: block; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: .92rem; font-weight: 600; }
  .side-box li a span { color: var(--green); }
  .side-cta { display: block; margin-top: 14px; text-align: center; padding: 10px; background: var(--ink); color: #fff; font-weight: 700; font-size: .88rem; }
  .side-cta:hover { color: #fff; background: #1e293b; }

  .prices { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .price { background: #fff; padding: 16px; display: flex; flex-direction: column; gap: 2px; }
  .price span { font-weight: 700; font-size: .88rem; }
  .price b { font: 800 1.35rem var(--font-head); margin-top: 4px; }
  .price em { font-style: normal; font-size: .74rem; color: var(--muted); }
  .upd { margin: 12px 0 0; font-size: .8rem; color: var(--muted); }

  @media (max-width: 1080px) {
    .top-grid { grid-template-columns: 1fr; }
    .side { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .cards-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .with-side { grid-template-columns: 1fr; }
    .side-col .sticky { position: static; align-items: center; }
    .side-box { width: 100%; max-width: 600px; box-sizing: border-box; }
    .prices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .top { padding-top: 0; }
    .top-grid { padding: 0; gap: 20px; }
    .feature, .cards-2 { grid-template-columns: 1fr; }
    .prices { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .cards-4 { grid-template-columns: 1fr; gap: 18px; }
    .cards-4 .nc { display: grid; grid-template-columns: 120px 1fr; column-gap: 14px; row-gap: 4px; align-content: start; }
    .cards-4 .nc-img { grid-row: span 3; aspect-ratio: 4 / 3; }
    .cards-4 .nc-cat { margin-top: 0; }
    .cards-4 .nc h3 { font-size: .95rem; }
  }
</style>
