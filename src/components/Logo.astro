---
// EV Türkiye ana logo (yatay). Yazı vektöre çevrilmiş SVG: her ekranda aynı görünür.
const { variant = 'renkli', height = 34 } = Astro.props;
const src = variant === 'beyaz' ? '/brand/ev-turkiye-logo-beyaz.svg' : '/brand/ev-turkiye-logo.svg';
---
<img class="logo" src={src} alt="EV Türkiye" height={height} style={`height:${height}px;width:auto`} />
<style>.logo { display: block; }</style>
