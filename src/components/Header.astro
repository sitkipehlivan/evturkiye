---
import Logo from './Logo.astro';
import AdSlot from './AdSlot.astro';
const path = Astro.url.pathname;
const hasAuth = !!(import.meta.env.PUBLIC_FIREBASE_CONFIG || process.env.PUBLIC_FIREBASE_CONFIG);
const nav = [
  { href: '/haberler', label: 'Haberler' },
  { href: '/haberler/turkiye', label: 'Türkiye' },
  { href: '/haberler/dunya', label: 'Dünya' },
  { href: '/haberler/hibrit', label: 'Plug-in Hibrit' },
  { href: '/elektrikli-arac', label: 'EV Rehberi' },
  { href: '/rota-planlayici', label: 'Rota Planlayıcı', hl: true },
  { href: '/sarj-fiyatlari', label: 'Şarj Fiyatları' },
  { href: '/yakindaki-sarj-istasyonlari', label: 'Yakınımdaki Şarj' },
  { href: '/firsatlar', label: 'Fırsatlar' },
  { href: '/modeller', label: 'Modeller' },
  { href: '/karsilastir', label: 'Karşılaştır' },
];
const active = (h: string) => (h === '/haberler' ? path === '/haberler' || path === '/haberler/' : path === h || path.startsWith(h + '/'));
const today = new Date().toLocaleDateString('tr-TR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Istanbul' });
---
<div class="top-ad"><AdSlot id="masthead" size="970x250" mobile="320x100" /></div>
<header class="site-header">
  <div class="utility">
    <div class="container util-in">
      <span class="date">{today}</span>
      <span class="tag-line">EV Türkiye: Electric Vehicle Türkiye</span>
      <nav class="util-links" aria-label="Hızlı bağlantılar">
        <a href="/sarj-fiyatlari">Güncel şarj fiyatları</a>
        <a href="/firsatlar">Kampanyalar</a>
      </nav>
    </div>
  </div>
  <div class="container main-row">
    <button class="menu-btn" aria-label="Menüyü aç" aria-expanded="false"><span></span><span></span><span></span></button>
    <a href="/" class="brand" aria-label="EV Türkiye ana sayfa"><Logo height={34} /></a>
    <form class="search" action="/ara" method="get" role="search">
      <label class="visually-hidden" for="hdr-q">Sitede ara</label>
      <input id="hdr-q" name="q" type="search" placeholder="EV Türkiye'de ara…" />
      <button type="submit" aria-label="Ara">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </button>
    </form>
    <div class="actions">
      <a href="/ara" class="icon-btn search-mobile" aria-label="Ara">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <a href="/yakindaki-sarj-istasyonlari" class="icon-btn" aria-label="Yakınımdaki şarj istasyonları">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"></path><path d="m12.6 6.5-2.4 3.6h3.4l-2.4 3.6"></path></svg>
      </a>
      <button type="button" class="icon-btn" aria-label="Uygulamayı yükle" title="Uygulamayı yükle" data-install hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><path d="M12 7.5v7"></path><path d="m9 11.5 3 3 3-3"></path></svg>
      </button>
      {hasAuth && (
        <a href="/hesabim" class="icon-btn" aria-label="Hesabım" data-account>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>
        </a>
      )}
      <a href="/rota-planlayici" class="btn btn-volt cta">Rotanı Planla</a>
    </div>
  </div>
  <nav class="cat-nav" aria-label="Ana menü">
    <div class="container cat-in">
      {nav.map((n) => <a href={n.href} class:list={{ active: active(n.href), hl: n.hl }}>{n.label}</a>)}
    </div>
  </nav>
  <div class="mobile-nav" hidden>
    {nav.map((n) => <a href={n.href} class:list={{ active: active(n.href) }}>{n.label}</a>)}
  </div>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const mob = document.querySelector('.mobile-nav') as HTMLElement | null;
  btn?.addEventListener('click', () => {
    if (!mob) return;
    const open = mob.hidden;
    mob.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.classList.toggle('open', open);
  });
</script>

<style>
  .top-ad { background: #f6f8fa; }
  .top-ad :global(.ad-slot:not([hidden])) { margin: 0 auto; }
  .site-header { position: relative; z-index: 1000; background: #fff; }
  .utility { background: var(--ink); color: #cbd5e1; font-size: .78rem; }
  .util-in { display: flex; align-items: center; gap: 20px; height: 34px; }
  .date { text-transform: capitalize; }
  .tag-line { margin: 0 auto; color: #94a3b8; letter-spacing: .04em; }
  .util-links { display: flex; gap: 18px; }
  .util-links a { color: #e2e8f0; font-weight: 500; }
  .util-links a:hover { color: #fff; }

  .main-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 28px; height: 76px; }
  .brand { display: block; }
  .search { position: relative; max-width: 440px; width: 100%; justify-self: center; }
  .search input { height: 42px; padding: 0 44px 0 16px; border-radius: 999px; background: var(--soft); border-color: var(--soft); font-size: .9rem; }
  .search input:focus { background: #fff; }
  .search button { position: absolute; right: 4px; top: 4px; width: 34px; height: 34px; border: 0; background: none; color: var(--ink-2); cursor: pointer; border-radius: 50%; display: grid; place-items: center; }
  .actions { display: flex; align-items: center; gap: 6px; }
  .icon-btn { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 50%; color: var(--ink); }
  .icon-btn:hover { background: var(--soft); color: var(--volt); }
  .search-mobile { display: none; }
  .cta { height: 40px; font-size: .88rem; margin-left: 6px; }

  .cat-nav { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); position: relative; }
  .cat-nav::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--grad); }
  .cat-in { display: flex; justify-content: center; gap: 4px 17px; flex-wrap: wrap; padding: 12px 20px; }
  .cat-in a { font-family: var(--font-head); font-size: .76rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--ink); padding: 2px 0; border-bottom: 2px solid transparent; }
  .cat-in a:hover { color: var(--volt); }
  .cat-in a.active { border-bottom-color: var(--green); }
  .cat-in a.hl { color: var(--green); }

  .menu-btn { display: none; width: 42px; height: 42px; border: 0; background: none; cursor: pointer; position: relative; padding: 0; }
  .menu-btn span { position: absolute; left: 10px; right: 10px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .2s, opacity .2s; }
  .menu-btn span:nth-child(1) { top: 13px; } .menu-btn span:nth-child(2) { top: 20px; } .menu-btn span:nth-child(3) { top: 27px; }
  .menu-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-btn.open span:nth-child(2) { opacity: 0; }
  .menu-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-nav { border-top: 1px solid var(--line); padding: 8px 20px 16px; background: #fff; max-height: 70vh; overflow: auto; }
  .mobile-nav a { display: block; padding: 12px 4px; font-weight: 600; border-bottom: 1px solid var(--line); }
  .mobile-nav a.active { color: var(--volt); }

  @media (max-width: 1040px) {
    .search { display: none; }
    .search-mobile { display: grid; }
    .main-row { grid-template-columns: auto 1fr auto; }
    .tag-line { display: none; }
    .util-links { margin-left: auto; }
  }
  @media (max-width: 860px) {
    .cat-nav { display: none; }
    .menu-btn { display: block; }
    .main-row { grid-template-columns: auto 1fr auto; height: 64px; gap: 8px; }
    .brand { justify-self: center; }
    .brand :global(img) { height: 28px !important; }
    .cta { display: none; }
    .site-header { border-bottom: 1px solid var(--line); }
    .site-header::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--grad); }
  }
  @media (max-width: 520px) { .util-links a:last-child { display: none; } }
</style>
