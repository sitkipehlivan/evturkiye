---
import Logo from './Logo.astro';
import routes from '../data/routes.json';
import { GUIDES } from '../lib/ev';
const year = new Date().getFullYear();
// Advance Digital mecraları şeridi (tüm Advance sitelerinde aynı; logolar public/mecralar/)
const MECRALAR = `<section class="adv-mecralar" aria-label="Advance Digital mecraları"><style>.adv-mecralar{background:#f6f6f3;border-top:1px solid rgba(0,0,0,.08);padding:22px 16px 24px;font:500 11px/1.4 system-ui,-apple-system,'Segoe UI',sans-serif;color:#6b6b6b}.adv-mecralar__in{max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:14px 30px}.adv-mecralar__baslik{letter-spacing:.12em;color:#7a7a7a;text-decoration:none;white-space:nowrap}.adv-mecralar__baslik:hover{color:#222}.adv-mecralar ul{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:16px 30px;list-style:none;margin:0;padding:0}.adv-mecralar li{margin:0;padding:0;list-style:none}.adv-mecralar li a{display:block;line-height:0}.adv-mecralar img{height:24px;width:auto;max-width:none;display:block;filter:grayscale(1);opacity:.62;transition:filter .2s,opacity .2s}.adv-mecralar li a:hover img,.adv-mecralar li a:focus-visible img{filter:none;opacity:1}@media (max-width:600px){.adv-mecralar__in{flex-direction:column;gap:14px}.adv-mecralar ul{gap:14px 24px}.adv-mecralar img{height:20px}}</style><div class="adv-mecralar__in"><a class="adv-mecralar__baslik" href="https://advancedigital.media/" target="_blank" rel="noopener">ADVANCE DIGITAL MECRALARI</a><ul><li><a href="https://mesaimutfak.com/" target="_blank" rel="noopener" title="Mesai Mutfak"><img src="/mecralar/mesaimutfak.png" alt="Mesai Mutfak" width="169" height="24" loading="lazy" decoding="async"></a></li><li><a href="https://amorti.online/" target="_blank" rel="noopener" title="Amorti"><img src="/mecralar/amorti.png" alt="Amorti" width="120" height="24" loading="lazy" decoding="async"></a></li><li><a href="https://guntabagi.com.tr/" target="_blank" rel="noopener" title="Gün Tabağı"><img src="/mecralar/guntabagi.png" alt="Gün Tabağı" width="155" height="24" loading="lazy" decoding="async"></a></li><li><a href="https://thehumblemag.com/" target="_blank" rel="noopener" title="The Humble Mag"><img src="/mecralar/thehumblemag.png" alt="The Humble Mag" width="195" height="24" loading="lazy" decoding="async"></a></li><li><a href="https://advancedigital.media/" target="_blank" rel="noopener" title="Advance Digital"><img src="/mecralar/advance.png" alt="Advance Digital" width="101" height="24" loading="lazy" decoding="async"></a></li></ul></div></section>`;
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brand">
      <Logo height={30} />
      <p class="muted small">Türkiye'nin elektrikli araç rehberi: rota ve şarj planlama, güncel kWh fiyatları, haberler ve kampanyalar.</p>
    </div>
    <div>
      <h4>Araçlar</h4>
      <a href="/rota-planlayici">Rota & Maliyet Planlayıcı</a>
      <a href="/sarj-fiyatlari">Şarj Fiyatları</a>
      <a href="/yakindaki-sarj-istasyonlari">Yakınımdaki Şarj İstasyonları</a>
      <a href="/istasyonlar">Şarj İstasyonu Haritası</a>
      <a href="/modeller">EV Modelleri</a>
    </div>
    <div>
      <h4>İçerik</h4>
      <a href="/haberler/turkiye">Türkiye</a>
      <a href="/haberler/dunya">Dünya</a>
      <a href="/haberler/hibrit">Plug-in Hibrit</a>
      <a href="/firsatlar">Kampanyalar</a>
    </div>
    <div>
      <h4>Rehberler</h4>
      {GUIDES.map((g) => <a href={g.href}>{g.short}</a>)}
      <a href="/haberler/rehber">Rehber yazıları</a>
    </div>
    <div>
      <h4>Popüler Rotalar</h4>
      {routes.slice(0, 6).map((r) => <a href={`/rota/${r.slug}`}>{r.from} – {r.to}</a>)}
    </div>
  </div>
  <div class="container legal">
    <span>© {year} EV Türkiye</span>
    <span><a href="/hakkimizda">Hakkımızda</a> · <a href="/kunye">Künye</a> · <a href="/yayin-ilkeleri">Yayın İlkeleri</a> · <a href="/kvkk-aydinlatma-metni">KVKK Aydınlatma Metni</a> · <a href="/uyelik-sozlesmesi">Üyelik Koşulları</a> · <a href="/cerez-politikasi">Çerez Politikası</a> · <a href="/site-haritasi">Site Haritası</a> · <button type="button" class="cookie-link" data-cerez-ac>Çerez tercihleri</button></span>
    <span>Fiyatlar bilgilendirme amaçlıdır; şarj öncesi operatör uygulamasından teyit edin.</span>
  </div>
</footer>
<Fragment set:html={MECRALAR} />
<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--soft); margin-top: 40px; padding: 48px 0 24px; }
  .cols { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr; gap: 32px; }
  .brand p { margin-top: 14px; max-width: 300px; }
  h4 { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 12px; }
  .cols a { display: block; padding: 4px 0; font-size: .93rem; color: var(--ink-2); }
  .legal { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .82rem; color: var(--muted); }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>
<style>
  .cookie-link { background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
</style>
