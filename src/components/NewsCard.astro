---
import { CATS, fmtDate, type Cat } from '../lib/util';
const { post, large = false } = Astro.props;
const d = post.data;
const cat = d.category as Cat;
---
<a href={`/haberler/${cat}/${post.id}`} class:list={['card', 'news', { large }]}>
  <div class:list={['thumb', cat]}>
    {d.image ? <img src={d.image} alt="" loading="lazy" /> : (
      <svg viewBox="0 0 120 60" aria-hidden="true"><path d="M66 6 46 33h14l-6 21 22-30H62l4-18Z" fill="currentColor" opacity=".9" /></svg>
    )}
  </div>
  <div class="body">
    <div class="meta"><span class:list={['tag', cat === 'rehber' ? 'green' : 'volt']}>{CATS[cat].label}</span><span>{fmtDate(d.date)}</span></div>
    <h3>{d.title}</h3>
    {large && <p class="muted">{d.description}</p>}
  </div>
</a>
<style>
  .news { display: flex; flex-direction: column; overflow: hidden; height: 100%; }
  .thumb { aspect-ratio: 16 / 8; display: grid; place-items: center; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb svg { width: 34%; }
  .thumb.turkiye { background: radial-gradient(120% 120% at 0% 100%, #dff3ff 0%, #f4faff 60%); color: var(--volt); }
  .thumb.dunya { background: radial-gradient(120% 120% at 100% 0%, #e3ecff 0%, #f6f8ff 60%); color: #3b5bfd; }
  .thumb.rehber { background: radial-gradient(120% 120% at 0% 0%, #dcf5e6 0%, #f4fbf7 60%); color: var(--green); }
  .body { padding: 16px 18px 20px; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: .8rem; color: var(--muted); margin-bottom: 10px; }
  h3 { font-size: 1.06rem; margin: 0; }
  .large .thumb { aspect-ratio: 16 / 7; }
  .large h3 { font-size: 1.45rem; margin-bottom: 8px; }
  .large p { margin: 0; }
</style>
