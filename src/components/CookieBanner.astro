---
// Çerez bildirimi: analitik çerezler (Google Analytics) yalnızca "Kabul et" ile açılır.
---
<div class="ck" id="ck" role="dialog" aria-live="polite" aria-label="Çerez tercihleri" hidden>
  <p>Sitenin nasıl kullanıldığını anlamak için, onay verirseniz <b>Google Analytics</b> analitik çerezlerini kullanıyoruz. Zorunlu çerezler her zaman açıktır. <a href="/cerez-politikasi">Çerez Politikası</a></p>
  <div class="ck-btns">
    <button type="button" class="ck-no" data-v="red">Reddet</button>
    <button type="button" class="ck-yes" data-v="kabul">Kabul et</button>
  </div>
</div>
<script is:inline>
  (function () {
    var box = document.getElementById('ck');
    var get = function () { try { return localStorage.getItem('evt-cerez'); } catch (e) { return null; } };
    var show = function () { box.hidden = false; };
    if (!get()) show();
    box.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-v');
        try { localStorage.setItem('evt-cerez', v); } catch (e) {}
        if (window.gtag) gtag('consent', 'update', { analytics_storage: v === 'kabul' ? 'granted' : 'denied' });
        box.hidden = true;
      });
    });
    document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('[data-cerez-ac]')) show(); });
  })();
</script>
<style>
  .ck { position: fixed; z-index: 90; left: 16px; right: 16px; bottom: 16px; max-width: 560px; margin: 0 auto; background: #0b1f3a; color: #e6efff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 14px 40px rgba(0, 0, 0, .25); display: flex; gap: 14px; align-items: center; font-size: .84rem; line-height: 1.45; }
  .ck[hidden] { display: none; }
  .ck p { margin: 0; flex: 1; }
  .ck a { color: #8fc2ff; text-decoration: underline; }
  .ck-btns { display: flex; gap: 8px; flex: none; }
  .ck button { height: 36px; padding: 0 14px; border-radius: 9px; font: 700 .84rem var(--font); cursor: pointer; border: 1px solid rgba(255, 255, 255, .35); background: transparent; color: #fff; }
  .ck .ck-yes { background: #2ee07a; border-color: #2ee07a; color: #062814; }
  @media (max-width: 560px) { .ck { flex-direction: column; align-items: stretch; } .ck-btns button { flex: 1; } }
</style>
