---
// Çerez bildirimi: üç seçenek. "Tümünü kabul et" analitik + reklam; "Sadece istatistik" yalnızca analitik
// (reklamlar kişiselleştirilmez); "Reddet" ikisine de izin vermez. Zorunlu çerezler her zaman açıktır.
---
<div class="ck" id="ck" role="dialog" aria-live="polite" aria-label="Çerez tercihleri" hidden>
  <p>Sitenin kullanımını ölçmek için <b>Google Analytics</b>, ilgi alanınıza uygun reklamlar için <b>Google AdSense</b> çerezlerini kullanıyoruz. Hangisine izin veriyorsunuz? Zorunlu çerezler her zaman açıktır. <a href="/cerez-politikasi">Çerez Politikası</a></p>
  <div class="ck-btns">
    <button type="button" class="ck-yes" data-v="kabul">Tümünü kabul et</button>
    <button type="button" class="ck-stat" data-v="istatistik">Sadece istatistik</button>
    <button type="button" class="ck-no" data-v="red">Reddet</button>
  </div>
</div>
<script is:inline>
  (function () {
    var box = document.getElementById('ck');
    var get = function () { try { return localStorage.getItem('evt-cerez'); } catch (e) { return null; } };
    var show = function () { box.hidden = false; };
    if (!get()) show();
    box.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-v');
        try { localStorage.setItem('evt-cerez', v); } catch (e) {}
        if (window.gtag) {
          var ad = v === 'kabul' ? 'granted' : 'denied', an = (v === 'kabul' || v === 'istatistik') ? 'granted' : 'denied';
          gtag('consent', 'update', { analytics_storage: an, ad_storage: ad, ad_user_data: ad, ad_personalization: ad });
        }
        box.hidden = true;
      });
    });
    document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('[data-cerez-ac]')) show(); });
  })();
</script>
<style>
  .ck { position: fixed; z-index: 90; left: 16px; right: 16px; bottom: 16px; max-width: 620px; margin: 0 auto; background: #0b1f3a; color: #e6efff; border-radius: 14px; padding: 14px 16px; box-shadow: 0 14px 40px rgba(0, 0, 0, .25); display: flex; flex-direction: column; gap: 12px; font-size: .84rem; line-height: 1.45; }
  .ck[hidden] { display: none; }
  .ck p { margin: 0; }
  .ck a { color: #8fc2ff; text-decoration: underline; }
  .ck-btns { display: flex; gap: 8px; }
  .ck button { flex: 1; height: 38px; padding: 0 14px; border-radius: 9px; font: 700 .84rem var(--font); cursor: pointer; border: 1px solid rgba(255, 255, 255, .55); background: transparent; color: #fff; }
  .ck .ck-yes { background: #2ee07a; border-color: #2ee07a; color: #062814; }
  .ck .ck-no { border-color: rgba(255, 255, 255, .22); color: rgba(230, 239, 255, .78); font-weight: 600; }
  .ck .ck-no:hover { border-color: rgba(255, 255, 255, .55); color: #fff; }
  @media (max-width: 560px) { .ck-btns { flex-direction: column; } .ck button { flex: none; height: 42px; } }
</style>
