---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import InstallApp from '../components/InstallApp.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AuthDialog from '../components/AuthDialog.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: object;
  noindex?: boolean;
  /** Konum çizgisi: [ad, yol] çiftleri; ana sayfa otomatik eklenir. BreadcrumbList JSON-LD üretir. */
  crumbs?: [string, string][];
}
const {
  title,
  description = 'Elektrikli araç rota ve şarj planlayıcı, güncel şarj fiyatları, EV haberleri, kampanyalar ve model karşılaştırmaları.',
  image = '/images/og-default.png',
  type = 'website',
  jsonLd,
  noindex = false,
  crumbs,
} = Astro.props;
// Google Search Console HTML etiketi doğrulaması: Netlify'da GSC_VERIFICATION ortam değişkeni (birden fazlaysa virgülle)
const fbRaw = import.meta.env.PUBLIC_FIREBASE_CONFIG || process.env.PUBLIC_FIREBASE_CONFIG || '';
const fbMeta = fbRaw ? Buffer.from(fbRaw, 'utf8').toString('base64') : '';
const gsc = (process.env.GSC_VERIFICATION ?? '').split(',').map((x) => x.trim()).filter(Boolean);
// Marka eki yalnızca başlık arama sonucunda kesilmeyecek uzunluktaysa eklenir (~60 karakter)
const fullTitle = title.includes('EV Türkiye') || title.length > 47 ? title : `${title} | EV Türkiye`;
// Açıklama ~160 karakteri aşarsa kelime sınırında kısaltılır
const metaDesc = description.length <= 160 ? description : description.slice(0, 157).replace(/[\s,.;:]+\S*$/, '') + '…';
const crumbLd = crumbs?.length ? {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [['Ana sayfa', '/'], ...crumbs].map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(path, Astro.site).toString() })),
} : null;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Advance reklam sunucusu adresi
const ADV_URL = 'https://advance-reklam.netlify.app';
// Advance Adserver yayıncı modülü (CDN). Boş bırakılırsa eski reklam sunucusu (ADV_URL/a.js) kullanılır — anında geri dönüş.
const AA_SITE = 'y7n6ji906r';
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="tr" data-sayfa={Astro.url.pathname === '/' ? 'ana' : 'alt'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Google Analytics 4 + AdSense, Consent Mode v2: analitik ve reklam çerezleri yalnızca ziyaretçi onay verirse açılır;
      // onay yoksa AdSense kişiselleştirilmemiş/sınırlı reklam gösterir.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var c = null;
        try { c = localStorage.getItem('evt-cerez'); } catch (e) {}
        var ok = c === 'kabul' ? 'granted' : 'denied', an = (c === 'kabul' || c === 'istatistik') ? 'granted' : 'denied';
        gtag('consent', 'default', { analytics_storage: an, ad_storage: ok, ad_user_data: ok, ad_personalization: ok, wait_for_update: 500 });
      })();
      gtag('js', new Date());
      gtag('config', 'G-6S4Y5HKH1N');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6S4Y5HKH1N"></script>
    <!-- AdSense: doğrulama etiketi her zaman; betik yalnız reklam çerezleri kabul edilince (KVKK) -->
    <meta name="google-adsense-account" content="ca-pub-5841017945537557" />
    <script is:inline>(function(){var y=0;function ac(){if(y)return;var c=null;try{c=localStorage.getItem('evt-cerez')}catch(e){}if(c!=='kabul')return;y=1;var s=document.createElement('script');s.async=1;s.crossOrigin='anonymous';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5841017945537557';document.head.appendChild(s)}ac();document.addEventListener('evt-cerez',ac)})();</script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {gsc.map((c) => <meta name="google-site-verification" content={c} />)}
    {fbMeta && <meta name="evt-fb" content={fbMeta} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="EV Türkiye" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/app/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="EV Türkiye" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Yazı tipleri kendi sunucumuzdan (Google Fonts'a istek yok: KVKK yurt dışı aktarım) -->
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Büyük harfli etiketler Türkçe kurala göre çevrilir (i → İ). Yabancı kelimeler
      // (Plug-in, marka/model adları) lang="en" ile işaretlenir; böylece büyük harfte noktasız I olur.
      (function () {
        var LIST = {};
        'plug-in plugin hybrid hybride electric edition line online premium mini kia fiat audi hyundai nissan mitsubishi skoda citroen citroën xiaomi nio lucid rivian dolphin clio niro prius civic explorer tiggo octavia picanto tiguan ariya kamiq kodiaq qashqai ioniq wallbox wi-fi google apple android'.split(' ').forEach(function (w) { LIST[w] = 1; });
        var foreign = function (w) {
          if (!/[iI]/.test(w)) return false;
          return !!LIST[w.toLowerCase()] || /[qwxQWX]/.test(w) || /^i[0-9A-Z]/.test(w) || /^ID\.[0-9]/.test(w);
        };
        var up = function (el) { return el && el.nodeType === 1 && getComputedStyle(el).textTransform === 'uppercase'; };
        var fixText = function (node) {
          var v = node.nodeValue;
          if (!/i/i.test(v)) return;
          var RE = /[0-9A-Za-zÇĞİÖŞÜçğıöşüë]+(?:[.\-][0-9A-Za-zÇĞİÖŞÜçğıöşüë]+)*/g;
          var frag = null, last = 0, m;
          while ((m = RE.exec(v))) {
            if (!foreign(m[0])) continue;
            frag = frag || document.createDocumentFragment();
            frag.appendChild(document.createTextNode(v.slice(last, m.index)));
            var sp = document.createElement('span');
            sp.lang = 'en'; sp.setAttribute('data-evt-en', '');
            sp.textContent = m[0];
            frag.appendChild(sp);
            last = m.index + m[0].length;
          }
          if (!frag) return;
          frag.appendChild(document.createTextNode(v.slice(last)));
          node.parentNode.replaceChild(frag, node);
        };
        var fix = function (root) {
          var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
            acceptNode: function (n) {
              var p = n.parentNode;
              if (!p || p.closest('script,style,textarea,[data-evt-en],[lang]:not(html)')) return NodeFilter.FILTER_REJECT;
              return up(p) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
            },
          });
          var list = [], n;
          while ((n = w.nextNode())) list.push(n);
          list.forEach(fixText);
        };
        fix(document.body);
        var t, q = [];
        new MutationObserver(function (m) {
          m.forEach(function (r) { r.addedNodes.forEach(function (n) { q.push(n.nodeType === 1 ? n : n.parentNode); }); });
          clearTimeout(t);
          t = setTimeout(function () { var l = q; q = []; l.forEach(function (n) { if (n && n.isConnected && !n.closest('[data-evt-en]')) fix(n); }); }, 50);
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    {fbMeta && <AuthDialog />}
    <CookieBanner />
    <script is:inline define:vars={{ ADV: ADV_URL, AA: AA_SITE }}>
      // Advance reklam sunucusu: masthead, banner alanları, raylar, pageskin ve geçiş reklamı (yönetim: ADV/panel)
      window.advance = {
        site: 'evturkiye', icerik: 1180, rayUst: 150,
        interstitial: 'evturkiye-interstitial', pageskin: 'evturkiye-pageskin', raylar: ['evturkiye-rail-sol', 'evturkiye-rail-sag'],
        haricYollar: '^/(hesabim|admin|reklam-rapor|offline)',
        riza: function () { try { return localStorage.getItem('evt-cerez') === 'kabul'; } catch (e) { return false; } },
      };
      document.addEventListener('evt-cerez', function () { if (window.advance.yenile) window.advance.yenile(); });
      // Masthead ve ilk ekrandaki 300x250 boş kalırsa yeri kapanmaz, EV Türkiye tanıtımı gösterilir (CLS olmasın)
      document.addEventListener('adv-bos', function (e) {
        var s = e.target, id = s && s.getAttribute && s.getAttribute('data-tanitim'); if (!id) return;
        var t = document.getElementById(id); if (!t) return;
        s.style.display = ''; s.innerHTML = t.innerHTML;
      });
      var s = document.createElement('script'); s.async = true;
      if (AA) { s.src = 'https://ads.advancedigital.media/aa/yl.js?v=' + Math.floor(Date.now() / 36e5); s.setAttribute('data-site', AA); }
      else s.src = ADV + '/a.js';
      document.head.appendChild(s);
    </script>
    <script is:inline>
      // Çerezsiz ziyaret sayacı: çerez, cihaz kimliği, IP saklamaz; yalnızca sayfa yolu ve reklam etiketi (utm) toplam olarak sayılır.
      (function () {
        try {
          if (navigator.webdriver) return;
          var q = new URLSearchParams(location.search), d = { p: location.pathname };
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) { var v = q.get(k); if (v) d[k.slice(4)] = v.slice(0, 80); });
          var b = JSON.stringify(d);
          if (navigator.sendBeacon) navigator.sendBeacon('/api/ziyaret', new Blob([b], { type: 'application/json' }));
          else fetch('/api/ziyaret', { method: 'POST', body: b, keepalive: true, headers: { 'content-type': 'application/json' } });
        } catch (e) {}
      })();
    </script>
    <InstallApp />
  </body>
</html>
